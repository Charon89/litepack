# The libarchive release LitePack vendors (E4-4). The one place the pin is written: scripts/libarchive-config.sh
# and .github/workflows/libarchive-config.yml both read it. Plain KEY=value lines (no spaces, no quotes), so
# bash can `source` it and the workflow can append it to $GITHUB_ENV.
LIBARCHIVE_VERSION=3.8.11
LIBARCHIVE_FILE=libarchive-3.8.11.tar.gz
LIBARCHIVE_URL=https://github.com/libarchive/libarchive/releases/download/v3.8.11/libarchive-3.8.11.tar.gz
LIBARCHIVE_SHA256=900fe9fc7237c2b04f090f3c3648de8fe597525771f5035016537ce2d667d12b
