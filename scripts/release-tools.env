# The exact versions of the build tools the release builds install (E7-2): .github/workflows/release-checks.yml
# (and release.yml, E7-2 part 1b) read this file; scripts/repro-build.sh uses the tools it names. Plain KEY=value
# lines (no spaces, no quotes), so bash can `source` it and a workflow can append it to $GITHUB_ENV.
# tauri-cli: the pin of CLAUDE.md, scripts/setup-windows.ps1 and ci.yml's GUI jobs.
TAURI_CLI_VERSION=2.12.4
# cargo-auditable: the release on crates.io when E7-2 part 1a pinned it (`cargo search cargo-auditable`).
CARGO_AUDITABLE_VERSION=0.7.7
