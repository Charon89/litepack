{
  "productName": "LitePack",
  "mainBinaryName": "lpk-gui",
  "version": "0.0.1",
  "identifier": "org.litepack.gui",
  "build": {
    "frontendDist": "../../apps/gui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; require-trusted-types-for 'script'; trusted-types 'none'",
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "E7-7 replaces this with the release signing public key",
      "endpoints": ["https://github.com/Charon89/litepack/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
