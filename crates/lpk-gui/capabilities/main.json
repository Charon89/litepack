  "permissions": [
    "allow-startup",
    "allow-settings",
    "allow-set-settings",
    "allow-open-archive",
    "allow-rows",
    "allow-view",
    "allow-select",
    "allow-open-entry",
    "allow-preview",
    "allow-pick",
    "allow-extract-plan",
    "allow-extract-run",
    "allow-extract-archive",
    "allow-recents",
    "allow-clear-recents",
    "allow-close-archive",
    "allow-create-plan",
    "allow-create-name",
    "allow-create-calibrate",
    "allow-create-scale",
    "allow-create-password",
    "allow-create-run",
    "allow-cancel",
    "allow-subscribe",
    "allow-listing-shown",
    "allow-test-run",
    "allow-test-archive",
    "allow-check-run",
    "allow-repair-run",
    "allow-history",
    "allow-history-browse",
    "allow-rollback-run",
    "allow-append-plan",
    "allow-append-run"
