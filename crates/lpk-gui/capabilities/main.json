{
  "identifier": "main",
  "description": "The main window: the archive browser's commands, nothing else (no plugin and no core permission; dialogs, the pickers included, and the update check run in Rust).",
  "windows": ["main"],
  "permissions": [
    "allow-startup",
    "allow-settings",
    "allow-set-settings",
    "allow-open-archive",
    "allow-rows",
    "allow-view",
    "allow-select",
    "allow-open-entry",
    "allow-pick",
    "allow-extract-plan",
    "allow-extract-run",
    "allow-extract-archive",
    "allow-recents",
    "allow-clear-recents",
    "allow-close-archive",
    "allow-create-archive",
    "allow-cancel",
    "allow-subscribe",
    "allow-listing-shown"
  ]
}
